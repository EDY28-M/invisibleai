{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InvisibleAI",
  "version": "1.0.0",
  "identifier": "com.edy28.invisibleai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "InvisibleAI - AI Assistant",
        "width": 600,
        "height": 54,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false,
        "contentProtected": true,
        "focus": false,
        "acceptFirstMouse": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["Info.plist", "invisibleai.desktop"],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "bundleName": "InvisibleAI"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:invisibleai.db"]
    },
    "updater": {
      "endpoints": ["https://invisibleai.com/api/update"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2MkQ5RjQyQ0Q3MTczNjUKUldSbGMzSE5RcDh0Um5FaEEvb1F0dVF3SzJWVVJkQ1ZPMzZDcHZIT3VNa08yb2VGRXl4dFVWZTkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
