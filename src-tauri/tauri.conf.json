{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InvisibleAI",
  "version": "1.5.3",
  "identifier": "com.edy28.invisibleai",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run clean:data && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Claude",
        "width": 780,
        "height": 54,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false,
        "contentProtected": true,
        "focus": false,
        "acceptFirstMouse": true,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["Info.plist", "invisibleai.desktop"],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "bundleName": "InvisibleAI",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:invisibleai.db"]
    },
    "updater": {
      "endpoints": ["https://invisibleai.online/api/update/{{target}}-{{arch}}/{{current_version}}"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDNkM0ODcxRjVCREIzMjEKUldRaHM3MzFjVWhzL0JUN0o3WEFTRXd2aGJJN1VHd0UxMy9RTUQ3ODBESWNmU2xqQkxUMEw1L3MK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
